{
  "name": "mycelium",
  "displayName": "Mycelium",
  "description": "Local-first context layer side panel for AI-heavy developers",
  "version": "0.0.1",
  "publisher": "mycelium",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onView:mycelium.sidePanel"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mycelium",
          "title": "Mycelium",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mycelium": [
        {
          "type": "webview",
          "id": "mycelium.sidePanel",
          "name": "Context"
        }
      ]
    },
    "commands": [
      {
        "command": "mycelium.openPanel",
        "title": "Mycelium: Open Panel"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
